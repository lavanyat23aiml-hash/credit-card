# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Environment variables and secrets
.env
.env.*
*.env
!.env.example

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Raw datasets are not committed
data/raw/*
!data/raw/.gitkeep

# Ignore temporary processed files
data/processed/*.tmp
data/processed/*.parquet

# Ignore temporary and large model files
models/*.onnx
models/*.h5
models/*_temp.pkl
models/*_temp.joblib

# Logs and temporary files
*.log
logs/
*.tmp

# Streamlit secrets
.streamlit/secrets.toml