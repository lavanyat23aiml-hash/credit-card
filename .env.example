# =============================================================================
# CreditGuard Environment Variables — Example Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#
# The application reads these values at startup via python-dotenv (if used)
# or through your container's environment variables.
# =============================================================================

# --- Application Settings -----------------------------------------------------
APP_ENV=production           # Options: development | production
APP_LOG_LEVEL=INFO           # Options: DEBUG | INFO | WARNING | ERROR

# --- Database Configuration ---------------------------------------------------
# Default is a local SQLite file. Override for PostgreSQL in production.
DB_PATH=data/creditguard.db
# DB_URL=postgresql://user:password@host:5432/creditguard  # (optional, future)

# --- Session Security ---------------------------------------------------------
# Secret key used for session token signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-random-secret-key

# --- Streamlit Secrets (for local run without secrets.toml) ------------------
# Prefer .streamlit/secrets.toml for local use.
# These can be overridden via environment variables in Docker/cloud deployments.

# --- Backup Configuration -----------------------------------------------------
BACKUP_DIR=data/backups

# --- Model Paths (override if using remote model store) -----------------------
MODEL_PIPELINE_PATH=models/creditguard_final_pipeline.joblib
MODEL_METADATA_PATH=models/creditguard_model_metadata.json

# --- Feature Flags -----------------------------------------------------------
ENABLE_XAI=true          # Set to false to disable Explainable AI tab
ENABLE_DATABASE=true     # Set to false to run in memory-only mode
INACTIVITY_TIMEOUT=1800  # Session timeout in seconds (default: 30 minutes)
